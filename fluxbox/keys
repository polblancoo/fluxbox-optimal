# ------------------------------------------------------------
# Scripts personales
# ------------------------------------------------------------

Mod1 F12 :Exec kitty --class=fluxhelp -o font_size=10 -e $HOME/.fluxbox/help.sh

# Redimensionar ventanas sin ratón (Alt + flechas)
Mod1 Right :ResizeHorizontal  +5%
Mod1 Left  :ResizeHorizontal  -5%
Mod1 Up    :ResizeVertical    -5%
Mod1 Down  :ResizeVertical    +5%
# Mover ventanas con Alt + Shift + flechas
Mod1 Shift Right :MoveRight 10
Mod1 Shift Left  :MoveLeft 10
Mod1 Shift Up    :MoveUp 10
Mod1 Shift Down  :MoveDown 10
# Enviar ventana a otro monitor (si tienes dos pantallas)
Mod1 1 :SetHead 1
Mod1 2 :SetHead 2
# Lanzador de apps (rofi) y selector de ventanas abiertas
Mod4 p :Exec rofi -show drun -modi drun
Mod4 w :Exec rofi -show window -modi window

# Terminal desplegable (F12): si no existe la crea; si existe la muestra/oculta
F12 :Exec $HOME/.fluxbox/scripts/scratchpad.sh

# ------------------------------------------------------------
# Lanzadores rápidos (Win + tecla)
# ------------------------------------------------------------
Mod4 Return :Exec kitty
Mod4 b      :Exec x-www-browser
Mod4 n      :Exec kitty -e nvim
Mod4 l      :Exec slock
Mod4 m       :Exec $HOME/.fluxbox/scripts/movie-mode.sh
Mod4 v       :Exec rofi -modi 'clipboard:greenclip print' -show clipboard -run-command '{cmd}'
Mod4 Shift b :Exec $HOME/.fluxbox/scripts/bt-menu.sh
Mod4 Shift p :Exec $HOME/.fluxbox/scripts/picom-toggle.sh
Mod4 a       :Exec $HOME/.fluxbox/scripts/audio-menu.sh
Mod4 o       :Exec $HOME/.fluxbox/scripts/rofi-proyectos.sh
Mod4 s       :Exec $HOME/.fluxbox/scripts/rofi-web.sh
Mod4 x       :Exec $HOME/.fluxbox/scripts/rofi-energia.sh
# Archivos, estudio y media
Mod4 f       :Exec $HOME/.fluxbox/scripts/filemanager.sh
Mod4 Escape  :Exec kitty -e btop
Mod4 e       :Exec $HOME/.fluxbox/scripts/study-mode.sh
Mod4 Shift n :Exec $HOME/.fluxbox/scripts/night-light.sh
# tubetui: YouTube en la terminal (Rust), video integrado en kitty, pestañas, música/videos locales
Mod4 y       :Exec kitty --class tubetui -T tubetui -e tubetui
Mod4 Shift y :Exec $HOME/.fluxbox/scripts/yt.sh baja

# Ayuda de atajos: Win + ? / Ctrl + ?  (tecla ' ? -> keycode 20)
Mod4 20       :Exec kitty --class=fluxhelp -o font_size=10 -e $HOME/.fluxbox/help.sh
Mod4 Shift 20 :Exec kitty --class=fluxhelp -o font_size=10 -e $HOME/.fluxbox/help.sh
Control Shift 20 :Exec kitty --class=fluxhelp -o font_size=10 -e $HOME/.fluxbox/help.sh

# ------------------------------------------------------------
# Ventanas a media pantalla (Win + Shift + flechas)
# ------------------------------------------------------------
Mod4 Shift Left  :MacroCmd {ResizeTo 50% 100%} {MoveTo 0 0 TopLeft}
Mod4 Shift Right :MacroCmd {ResizeTo 50% 100%} {MoveTo 0 0 TopRight}
Mod4 Shift Up    :Maximize
Mod4 Shift Down  :MacroCmd {ResizeTo 60% 70%} {MoveTo 0 0 Center}

# ------------------------------------------------------------
# Multimedia, brillo y capturas
# ------------------------------------------------------------
XF86AudioPlay  :Exec playerctl play-pause
XF86AudioPause :Exec playerctl play-pause
XF86AudioNext  :Exec playerctl next
XF86AudioPrev  :Exec playerctl previous
XF86MonBrightnessUp   :Exec brightnessctl set 5%+
XF86MonBrightnessDown :Exec brightnessctl set 5%-
Mod4 Prior :Exec brightnessctl set 5%+
Mod4 Next  :Exec brightnessctl set 5%-
Print       :Exec flameshot gui
Shift Print :Exec mkdir -p $HOME/Capturas && flameshot full -p $HOME/Capturas

# ------------------------------------------------------------
# Modo ventana estilo vim (Win + R): h/j/k/l mueven, Shift+h/j/k/l redimensionan,
# 1/2 = mitad izq/der, f = maximizar, Esc o Enter para salir
# ------------------------------------------------------------
Mod4 r :MacroCmd {KeyMode Ventana Escape} {Exec notify-send -t 2500 -h string:x-dunst-stack-tag:keymode "󰆾  Modo ventana" "h j k l mover · Shift redimensionar · 1/2 mitades · f max · Esc salir"}
Ventana: h :MoveLeft 30
Ventana: j :MoveDown 30
Ventana: k :MoveUp 30
Ventana: l :MoveRight 30
Ventana: Shift h :ResizeHorizontal -30
Ventana: Shift l :ResizeHorizontal +30
Ventana: Shift k :ResizeVertical -30
Ventana: Shift j :ResizeVertical +30
Ventana: 1 :MacroCmd {ResizeTo 50% 100%} {MoveTo 0 0 TopLeft}
Ventana: 2 :MacroCmd {ResizeTo 50% 100%} {MoveTo 0 0 TopRight}
Ventana: f :Maximize
Ventana: Return :MacroCmd {KeyMode default} {Exec dunstctl close}
