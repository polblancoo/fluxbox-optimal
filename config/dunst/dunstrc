[global]
    # Posición de la notificación en la pantalla
    origin = top-right
    # Separación del borde
    offset = 10x40
    # Tamaño
    width = 300
    height = 100

    # Estilo Tokyo Night
    font = MesloLGM Nerd Font 10
    frame_width = 2
    corner_radius = 8
    padding = 10
    horizontal_padding = 12
    gap_size = 6
    separator_color = frame
    icon_position = left
    max_icon_size = 40

[urgency_low]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#292e42"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
